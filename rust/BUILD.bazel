load(
    "@rules_rust//rust:defs.bzl",
    "rust_binary",
    "rust_clippy",
    "rust_library",
    "rust_test",
    "rustfmt_test",
)

# Ahab's own build. This package is reachable only when Ahab is the root
# module: a consumer takes the binary from a release instead, and so never
# loads this file or needs a Rust toolchain to do it.

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "ahab_lib",
    srcs = [
        "src/aquery.rs",
        "src/checks.rs",
        "src/cli.rs",
        "src/exceptions.rs",
        "src/glob.rs",
        "src/lib.rs",
        "src/melville.rs",
        "src/param_files.rs",
        "src/reproducibility_spec/library.rs",
        "src/reproducibility_spec/mod.rs",
        "src/reproducibility_spec/per_lang/cc.rs",
        "src/reproducibility_spec/per_lang/container.rs",
        "src/reproducibility_spec/per_lang/go.rs",
        "src/reproducibility_spec/per_lang/java.rs",
        "src/reproducibility_spec/per_lang/js.rs",
        "src/reproducibility_spec/per_lang/kotlin.rs",
        "src/reproducibility_spec/per_lang/mod.rs",
        "src/reproducibility_spec/per_lang/pkg.rs",
        "src/reproducibility_spec/per_lang/python.rs",
        "src/reproducibility_spec/per_lang/rust.rs",
        "src/reproducibility_spec/program_id.rs",
        "src/terminal_color.rs",
    ],
    crate_name = "ahab",
    deps = [
        "//proto:analysis_v2_rs_proto",
        "@ahab_crates//:anyhow",
        "@ahab_crates//:clap",
        "@ahab_crates//:prost",
        "@ahab_crates//:serde",
        "@ahab_crates//:serde_json",
        "@ahab_crates//:similar",
    ],
)

rust_binary(
    name = "ahab",
    srcs = ["src/main.rs"],
    # macOS records the oldest system a binary claims to run on, and left
    # alone it takes that from whatever SDK built it—so a release built on
    # the newest runner would refuse to start on anything older. 11.0 is
    # the floor for arm64 Macs and old enough on Intel to cover any macOS
    # still receiving security updates.
    rustc_flags = select({
        "@platforms//os:macos": ["-Clink-arg=-mmacosx-version-min=11.0"],
        "//conditions:default": [],
    }),
    deps = [
        ":ahab_lib",
        "@ahab_crates//:anyhow",
        "@ahab_crates//:clap",
    ],
)

rust_test(
    name = "ahab_lib_test",
    crate = ":ahab_lib",
    deps = [
        "//proto:analysis_v2_rs_proto",
        "@ahab_crates//:anyhow",
        "@ahab_crates//:clap",
        "@ahab_crates//:prost",
        "@ahab_crates//:serde",
        "@ahab_crates//:serde_json",
        "@ahab_crates//:similar",
    ],
)

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = [
        ":ahab",
        ":ahab_lib",
        ":ahab_lib_test",
    ],
)

rustfmt_test(
    name = "rustfmt_test",
    targets = [
        ":ahab",
        ":ahab_lib",
        ":ahab_lib_test",
    ],
)

alias(
    name = "format",
    actual = "@rules_rust//tools/rustfmt",
)
