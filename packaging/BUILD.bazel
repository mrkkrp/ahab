load("@ahab//:defs.bzl", "ahab", "ahab_check", "ahab_explain", "ahab_update")

# Every macro Ahab exposes, instantiated the way a consumer would. Building
# these is most of the test: it proves the module resolves, `defs.bzl` loads
# across the boundary, and each macro produces a launcher that builds.

ahab(
    name = "ahab.report",
    label = "//...",
    no_fail = True,
)

alias(
    name = "host_exceptions",
    actual = select({
        "@platforms//os:macos": "//:exceptions_macos.json",
        "//conditions:default": "//:exceptions_linux.json",
    }),
)

ahab_check(
    name = "ahab.check",
    baseline = "//:expectation.json",
    exceptions = [
        "//:host_exceptions",
        {
            "reason": "autoconfigured C++ toolchain (inline)",
            "kind": "system_program",
            "program": "*/bin/strip",
        },
    ],
    label = "//...",
)

ahab_update(
    name = "ahab.update",
    baseline = "//:expectation.json",
    exceptions = [
        "//:host_exceptions",
        {
            "reason": "autoconfigured C++ toolchain (inline)",
            "kind": "system_program",
            "program": "*/bin/strip",
        },
    ],
    label = "//...",
)

ahab_explain(
    name = "ahab.explain",
    report = "//:expectation.json",
)

exports_files([
    "exceptions_linux.json",
    "exceptions_macos.json",
    "expectation.json",
])
