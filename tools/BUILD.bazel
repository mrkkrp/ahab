load("@buildifier_prebuilt//:rules.bzl", "buildifier", "buildifier_test")

buildifier_test(
    name = "buildifier_test",
    size = "small",
    exclude_patterns = [
        "./.direnv/*",
        "./.git/*",
        "./fishery/*/work",
    ],
    lint_mode = "warn",
    mode = "diff",
    no_sandbox = True,
    workspace = "//:MODULE.bazel",
)

buildifier(
    name = "buildifier",
    exclude_patterns = [
        "./.direnv/*",
        "./.git/*",
        "./fishery/*/work",
    ],
    lint_mode = "fix",
    mode = "fix",
)

platform(
    name = "linux_musl",
    constraint_values = [
        "@llvm//constraints/libc:musl",
        "@llvm//constraints/pie:off",
        "@rules_rs//rs/platforms/constraints:musl",
    ],
    parents = ["@platforms//host"],
)
