module(
    name = "ahab",
    version = "0.4.0",
    bazel_compatibility = [">=8.0.0"],
)

###############################################################################
# Core deps
###############################################################################

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")

###############################################################################
# The binary
###############################################################################

prebuilt = use_extension("//private:extensions.bzl", "prebuilt")
use_repo(prebuilt, "ahab_prebuilt")

module_info = use_extension("//private:extensions.bzl", "module_info")
use_repo(module_info, "ahab_module_info")

###############################################################################
# Building Ahab itself
###############################################################################

bazel_dep(name = "rules_rs", version = "0.0.108", dev_dependency = True)
bazel_dep(name = "rules_proto", version = "7.1.0", dev_dependency = True)
bazel_dep(name = "protobuf", version = "35.1", dev_dependency = True)

###############################################################################
# Starlark formatting
###############################################################################

bazel_dep(
    name = "buildifier_prebuilt",
    version = "8.5.1.3",
    dev_dependency = True,
)

###############################################################################
# Hermetic C/C++ toolchain
###############################################################################

# Rust linking shells out to a C/C++ compiler, so without a registered cc
# toolchain Bazel falls back to whatever cc/ld happen to be on the host. The
# llvm module provides a zero-sysroot, fully hermetic LLVM-based cc
# toolchain.
bazel_dep(name = "llvm", version = "0.8.14", dev_dependency = True)

###############################################################################
# Rust toolchain
###############################################################################

RUST_VERSION = "1.92.0"

toolchains = use_extension(
    "@rules_rs//rs/toolchains:module_extension.bzl",
    "toolchains",
    dev_dependency = True,
)
toolchains.toolchain(
    edition = "2024",
    version = RUST_VERSION,
)
use_repo(toolchains, "default_rust_toolchains")

# rules_rs redistributes a patched rules_rust under its own name, which is
# what `//rust` and `//proto` load their rules from.
rules_rust = use_extension(
    "@rules_rs//rs:rules_rust.bzl",
    "rules_rust",
    dev_dependency = True,
)
use_repo(rules_rust, "rules_rust")

# rules_rs runs the MSVC build of rustc on Windows, which cannot load a proc
# macro built for MinGW, the one Windows ABI the hermetic LLVM toolchain
# supports. Windows gets the MinGW build of rustc from rules_rust's own
# extension instead, whose toolchains .bazelrc puts ahead of rules_rs's
# there. The set rules_rust would register for an MSVC host by default is
# replaced by one that requires the MSVC ABI, so that it cannot answer for
# the MinGW host too.
WINDOWS_GNULLVM = [
    "@platforms//cpu:x86_64",
    "@platforms//os:windows",
    "@llvm//constraints/windows/abi:gnullvm",
]

WINDOWS_MSVC = [
    "@platforms//cpu:x86_64",
    "@platforms//os:windows",
    "@llvm//constraints/windows/abi:msvc",
]

rust = use_extension(
    "@rules_rs//rs:rules_rust_reexported_extensions.bzl",
    "rust",
    dev_dependency = True,
)
rust.toolchain(
    edition = "2024",
    rustfmt_version = RUST_VERSION,
    versions = [RUST_VERSION],
)
rust.repository_set(
    name = "rust_windows_x86_64",
    exec_compatible_with = WINDOWS_MSVC,
    exec_triple = "x86_64-pc-windows-msvc",
    target_compatible_with = WINDOWS_MSVC,
    target_triple = "x86_64-pc-windows-msvc",
    versions = [RUST_VERSION],
)
rust.repository_set(
    name = "rust_windows_x86_64_gnullvm",
    edition = "2024",
    exec_compatible_with = WINDOWS_GNULLVM,
    exec_triple = "x86_64-pc-windows-gnullvm",
    target_compatible_with = WINDOWS_GNULLVM,
    target_triple = "x86_64-pc-windows-gnullvm",
    versions = [RUST_VERSION],
)
use_repo(rust, "rust_toolchains")

register_toolchains(
    "@default_rust_toolchains//...",
    "@llvm//toolchain:all",
    dev_dependency = True,
)

###############################################################################
# Third-party crate dependencies
###############################################################################

crate = use_extension(
    "@rules_rs//rs:extensions.bzl",
    "crate",
    dev_dependency = True,
)
crate.from_cargo(
    name = "ahab_crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-gnullvm",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
    ],
)
crate.annotation(
    crate = "protoc-gen-prost",
    gen_binaries = ["protoc-gen-prost"],
    repositories = ["ahab_crates"],
)
use_repo(crate, "ahab_crates")

register_toolchains(
    "//proto:prost_toolchain",
    dev_dependency = True,
)
