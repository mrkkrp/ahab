load("@ahab_module_info//:defs.bzl", "AHAB_IS_ROOT")
load("//:defs.bzl", "ahab")

package(default_visibility = ["//visibility:public"])

exports_files([
    ".rustfmt.toml",
    "MODULE.bazel",
])

alias(
    name = "ahab_bin",
    # Query follows every branch of a select() and //rust cannot be loaded
    # without the build dependencies that only the root module has,
    # therefore we cannot rely on a select() here.
    actual = "//rust:ahab" if AHAB_IS_ROOT else "@ahab_prebuilt//:ahab",
)

ahab(
    name = "hermeticity",
    exceptions = [
        {
            "kind": "execution_requirement",
            "target": "//tools:buildifier_test",
            "requirement": "no-sandbox",
        },
    ],
    label = "//...",
)
