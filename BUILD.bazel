load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("//:defs.bzl", "ahab")

package(default_visibility = ["//visibility:public"])

exports_files([
    ".rustfmt.toml",
    "MODULE.bazel",
])

bool_flag(
    name = "from_source",
    build_setting_default = False,
)

config_setting(
    name = "source_build",
    flag_values = {":from_source": "True"},
)

alias(
    name = "ahab_bin",
    actual = select({
        ":source_build": "//rust:ahab",
        "//conditions:default": "@ahab_prebuilt//:ahab",
    }),
)

ahab(
    name = "hermeticity",
    exceptions = [
        {
            "kind": "execution_requirement",
            "target": "//tools:buildifier_test",
            "requirement": "no-sandbox",
        },
    ],
    label = "//...",
)
